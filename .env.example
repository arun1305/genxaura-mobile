# Copy to .env (never commit .env) and fill in the values.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time.

# Base URL of the GenXAura REST API, including the /api/v1 prefix.
# The socket.io endpoint is derived from it (same origin, namespace /chat).
# REQUIRED for preview/production builds — a release build without it shows a
# configuration error instead of silently calling localhost.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1

# OAuth 2.0 *Web* client ID from the Firebase/Google Cloud project
# (Firebase console → Authentication → Sign-in method → Google → Web SDK configuration).
# Required for "Continue with Google"; the button shows "not configured" without it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Optional: Tenor API key enables the GIF picker in chat.
EXPO_PUBLIC_TENOR_API_KEY=
